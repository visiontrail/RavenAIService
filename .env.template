# LogStagingService 环境变量模板
# 复制此文件为 .env 并根据您的环境修改相应的值

# ===========================================
# 基本配置
# ===========================================

# 环境类型: development, production, testing
ENVIRONMENT=development

# 服务配置
HOST=0.0.0.0
PORT=8085

# ===========================================
# 数据库配置
# ===========================================

# PostgreSQL数据库连接URL
# 格式: postgresql://用户名:密码@主机:端口/数据库名
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/logstagingservice

# 数据库连接参数（用于Docker Compose）
POSTGRES_DB=logstagingservice
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ===========================================
# Redis配置
# ===========================================

# Redis连接URL
REDIS_URL=redis://redis:6379/0

# ===========================================
# 日志配置
# ===========================================

# 日志级别: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# 日志文件路径
LOG_FILE_PATH=logs/app.log

# ===========================================
# 文件配置
# ===========================================

# 最大文件上传大小（字节）
MAX_FILE_SIZE=1073741824

# 临时文件目录
TEMP_DIR=temp

# 日志文件目录
LOGS_DIR=logs

# 上传文件目录
UPLOADS_DIR=uploads

# ===========================================
# CORS配置
# ===========================================

# 允许的来源（JSON数组格式）
# 开发环境: ["*"]
# 生产环境: ["https://yourdomain.com"]
CORS_ORIGINS=["*"]

# 是否允许凭据
CORS_CREDENTIALS=true

# 允许的HTTP方法
CORS_METHODS=["*"]

# 允许的HTTP头
CORS_HEADERS=["*"]

# ===========================================
# 安全配置
# ===========================================

# 应用密钥（请在生产环境中使用强密钥）
SECRET_KEY=your-secret-key-here

# JWT密钥
JWT_SECRET_KEY=your-jwt-secret-key-here

# JWT算法
JWT_ALGORITHM=HS256

# JWT过期时间（分钟）
JWT_EXPIRE_MINUTES=30

# ===========================================
# Celery配置
# ===========================================

# Celery消息代理URL
CELERY_BROKER_URL=redis://redis:6379/0

# Celery结果后端URL
CELERY_RESULT_BACKEND=redis://redis:6379/0

# 任务序列化格式
CELERY_TASK_SERIALIZER=json

# 结果序列化格式
CELERY_RESULT_SERIALIZER=json

# 接受的内容类型
CELERY_ACCEPT_CONTENT=["json"]

# 时区设置
CELERY_TIMEZONE=Asia/Shanghai

# 是否启用UTC
CELERY_ENABLE_UTC=true

# ===========================================
# 性能配置
# ===========================================

# Worker进程数
WORKERS=4

# 最大连接数
MAX_CONNECTIONS=100

# 保持连接超时时间（秒）
KEEPALIVE_TIMEOUT=5

# ===========================================
# 监控配置
# ===========================================

# 是否启用指标监控
ENABLE_METRICS=false

# 指标监控端口
METRICS_PORT=9090

# ===========================================
# 邮件配置（可选）
# ===========================================

# SMTP服务器主机
SMTP_HOST=smtp.gmail.com

# SMTP服务器端口
SMTP_PORT=587

# SMTP用户名
SMTP_USER=your_email@gmail.com

# SMTP密码
SMTP_PASSWORD=your_app_password

# 是否启用TLS
SMTP_TLS=true

# 是否启用SSL
SMTP_SSL=false

# ===========================================
# 对象存储配置（可选）
# ===========================================

# AWS访问密钥ID
# AWS_ACCESS_KEY_ID=your_access_key

# AWS秘密访问密钥
# AWS_SECRET_ACCESS_KEY=your_secret_key

# AWS区域
# AWS_REGION=us-east-1

# S3存储桶名称
# S3_BUCKET=your-bucket-name

# ===========================================
# 备份配置
# ===========================================

# 备份保留天数
BACKUP_RETENTION_DAYS=30

# 是否启用自动备份
AUTO_BACKUP_ENABLED=false

# 备份计划（Cron表达式）
BACKUP_SCHEDULE="0 2 * * *"

# ===========================================
# 安全头配置
# ===========================================

# 是否强制SSL重定向
SECURE_SSL_REDIRECT=false

# HSTS最大年龄（秒）
SECURE_HSTS_SECONDS=0

# 是否在HSTS中包含子域
SECURE_HSTS_INCLUDE_SUBDOMAINS=false

# 是否启用内容类型嗅探保护
SECURE_CONTENT_TYPE_NOSNIFF=true

# 是否启用XSS过滤器
SECURE_BROWSER_XSS_FILTER=true

# 是否拒绝框架嵌入
SECURE_FRAME_DENY=false

# ===========================================
# 开发配置（仅开发环境）
# ===========================================

# 是否启用调试模式
DEBUG=false

# 是否启用热重载
RELOAD=false

# 是否启用热重载
HOT_RELOAD=false

# ===========================================
# 测试配置（仅测试环境）
# ===========================================

# 是否为测试环境
TESTING=false

# 测试数据库URL
TEST_DATABASE_URL=sqlite:///./test.db