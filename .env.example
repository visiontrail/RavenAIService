# 环境配置
ENVIRONMENT=development

# 服务配置
HOST=0.0.0.0
PORT=8085

# 日志配置
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/app.log

# 文件配置
MAX_FILE_SIZE=1073741824
TEMP_DIR=temp
LOGS_DIR=logs

# CORS配置 - 使用JSON格式的列表
CORS_ORIGINS=["*"]
CORS_CREDENTIALS=True
CORS_METHODS=["*"]
CORS_HEADERS=["*"]

# 安全配置
SECRET_KEY=your-secret-key-here
