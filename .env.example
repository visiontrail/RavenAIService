# 环境配置
ENVIRONMENT=development
HTTP_PORT=8085
IMAGE_TAG=local
DOCKERHUB_NAMESPACE=galaxyspaceai

# 服务配置
HOST=0.0.0.0
PORT=8085

# 日志配置
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/app.log
LOG_FILE_MAX_BYTES=52428800
LOG_FILE_BACKUP_COUNT=5
ENABLE_DEBUG_FILE_LOG=false

# 文件配置
MAX_FILE_SIZE=1073741824
TEMP_DIR=temp
LOGS_DIR=logs
DISK_RESERVE_BYTES=536870912

# 安全配置
SECRET_KEY=your-secret-key-here

# 数据库配置
DATABASE_URL=
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# Celery配置
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=["json"]
CELERY_TIMEZONE=UTC
CELERY_ENABLE_UTC=true

# Redis配置
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# 协议栈日志处理配置
LOG_PROCESSING_SPEED_MB_PER_SEC=100
MAX_RETRY_ATTEMPTS=3
TASK_TIMEOUT=3600
THREAD_NUM_FOR_DECOMPRESS=15

# SQLite配置（开发环境）
SQLITE_FILE=data/logs.db

# PostgreSQL配置（生产环境）
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=log_staging
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# Raven 包管理（已统一到 FastAPI 后端）
RAVEN_BASE_PATH=/raven
BASE_PATH=/raven
RAVEN_ENABLE_LEGACY_PATHS=true
RAVEN_DATA_DIR=/app/data/raven
RAVEN_METADATA_FILE=/app/data/raven/package-metadata.json
RAVEN_VECTOR_STORE_PATH=/app/data/raven/vector-store
UPLOAD_DIR=/app/data/raven/uploads
UPLOAD_MAX_SIZE_MB=500
LOG_API_PORT=8085
LOG_SERVER_PORT=8085

# Anthropic 标准 LLM 配置（日志分析 Agent / Claude Agent SDK）
# 默认使用 DeepSeek 的 Anthropic 兼容端点；如果使用官方 Anthropic，请设为 anthropic。
ANTHROPIC_PROVIDER=deepseek
ANTHROPIC_API_KEY=
# 可选：provider=custom 时必须配置；其他 provider 仅在需要覆盖默认 profile 时配置。
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=
ANTHROPIC_SMALL_FAST_MODEL=
ANTHROPIC_MAX_TOKENS=8192
ANTHROPIC_MAX_TURNS=30
ANTHROPIC_PERMISSION_MODE=acceptEdits
ANTHROPIC_REQUEST_TIMEOUT_SECONDS=1800
AI_ANALYSIS_MAX_EXTRACT_BYTES=2147483648

# ============================================
# RAG 向量搜索配置 (新增)
# ============================================

# Embedding Provider 选择
# 可选值: local | tongyi | openai_compatible
# - local: 使用后端内置轻量关键词索引（默认，无需网络）
# - tongyi/openai_compatible: 保留为兼容配置，后续可接入外部 Embeddings API
RAG_EMBEDDING_PROVIDER=tongyi

# Embedding 模型名称
# 根据 provider 不同，支持的模型也不同：
# - tongyi: text-embedding-v1 | text-embedding-v2 | text-embedding-v3 | text-embedding-v4 | multimodal-embedding-v1
#   推荐: text-embedding-v3（最新版本，效果最好）
# - openai_compatible: text-embedding-3-small | text-embedding-3-large | text-embedding-ada-002 等
#   推荐: text-embedding-3-small（性价比高）或 text-embedding-3-large（效果最好）
# - local: 不使用此配置（固定使用 Xenova/paraphrase-multilingual-MiniLM-L12-v2）
RAG_EMBEDDING_MODEL=text-embedding-v4

# ============================================
# 阿里云通义千问 Embeddings 配置
# ============================================
# 当 RAG_EMBEDDING_PROVIDER=tongyi 时需要配置
#
# 获取方式：
# 1. 访问 https://dashscope.console.aliyun.com/
# 2. 登录后进入"API-KEY管理"
# 3. 创建新的 API Key
# 4. 复制 API Key 并填入此处
ALIBABA_API_KEY=

# ============================================
# OpenAI 兼容 Embeddings 配置
# ============================================
# 当 RAG_EMBEDDING_PROVIDER=openai_compatible 时需要配置

# OpenAI API Key（必需）
# 如果使用第三方兼容网关（如 oneapi），使用网关提供的 API Key
OPENAI_API_KEY=

# OpenAI API Base URL（可选）
# 如果使用第三方兼容网关（如 oneapi），需要设置此值
# 例如: http://oneapi.yhroot.com/v1
# 如果不设置，将使用 OpenAI 官方 API: https://api.openai.com/v1
OPENAI_BASE_URL=http://oneapi.yhroot.com/v1


# ============================================
# 使用示例
# ============================================
#
# 示例 1: 使用本地嵌入模型（默认，无需额外配置）
#    RAG_EMBEDDING_PROVIDER=local
#
# 示例 2: 使用通义千问 Embeddings（推荐用于生产环境）
#    RAG_EMBEDDING_PROVIDER=tongyi
#    ALIBABA_API_KEY=sk-xxxxxxxxxxxxx
#    RAG_EMBEDDING_MODEL=text-embedding-v3
#
# 示例 3: 使用 OpenAI 兼容 Embeddings（通过 oneapi 网关）
#    RAG_EMBEDDING_PROVIDER=openai_compatible
#    OPENAI_API_KEY=sk-xxxxxxxxxxxxx
#    OPENAI_BASE_URL=http://oneapi.yhroot.com/v1
#    RAG_EMBEDDING_MODEL=Qwen3-Embedding-8B
#
# ============================================
# 注意事项
# ============================================
#
# 1. 切换 Embedding Provider 或 Model 时，系统会自动检测并重建向量库
#    旧向量库会被删除，需要重新索引所有包数据
#    建议在低峰期进行切换操作
#
# 2. 向量库元信息保存在: {RAVEN_VECTOR_STORE_PATH}.meta.json
#    包含 provider 和 modelName 信息，用于检测配置变更
#    不要手动删除此文件，除非确定要重建向量库
#
# 3. 如果向量维度不匹配导致检索错误，系统会自动触发重建
#    重建过程可能需要较长时间，取决于包的数量
#
# 4. 生产环境建议：
#       * 通义千问推荐: text-embedding-v3
#       * OpenAI 兼容推荐: text-embedding-3-small（性价比）或 text-embedding-3-large（效果）
#    - 确保 API Key 安全，不要提交到版本控制系统
#    - 定期备份向量库目录（{RAVEN_VECTOR_STORE_PATH}）
#
# 5. 性能提示：
#    - 本地模型（local）: 无需网络，但检索效果一般，适合开发测试
#    - 通义千问（tongyi）: 检索效果最好，支持中文优化，推荐生产使用
#    - OpenAI 兼容: 兼容性好，但可能对中文支持不如通义千问
#
# ============================================
