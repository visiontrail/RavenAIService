# 环境配置
ENVIRONMENT=development
HTTP_PORT=8085
IMAGE_TAG=local
DOCKERHUB_NAMESPACE=galaxyspaceai

# 服务配置
HOST=0.0.0.0
PORT=8085

# 日志配置
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/app.log
LOG_FILE_MAX_BYTES=52428800
LOG_FILE_BACKUP_COUNT=5
ENABLE_DEBUG_FILE_LOG=false

# 文件配置
MAX_FILE_SIZE=1073741824
TEMP_DIR=temp
LOGS_DIR=logs
DISK_RESERVE_BYTES=536870912

# 安全配置
SECRET_KEY=your-secret-key-here

# 数据库配置
DATABASE_URL=
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# Celery配置
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=["json"]
CELERY_TIMEZONE=UTC
CELERY_ENABLE_UTC=true

# Redis配置
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# 协议栈日志处理配置
LOG_PROCESSING_SPEED_MB_PER_SEC=100
MAX_RETRY_ATTEMPTS=3
TASK_TIMEOUT=3600
THREAD_NUM_FOR_DECOMPRESS=15

# SQLite配置（开发环境）
SQLITE_FILE=data/logs.db

# PostgreSQL配置（生产环境）
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=log_staging
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# Raven 包管理（已统一到 FastAPI 后端）
RAVEN_BASE_PATH=/raven
BASE_PATH=/raven
RAVEN_ENABLE_LEGACY_PATHS=true
RAVEN_DATA_DIR=/app/data/raven
RAVEN_METADATA_FILE=/app/data/raven/package-metadata.json
UPLOAD_DIR=/app/data/raven/uploads
UPLOAD_MAX_SIZE_MB=500
LOG_API_PORT=8085
LOG_SERVER_PORT=8085

# Anthropic 标准 LLM 配置（日志分析 / DeviceAgent / 标题生成 共用同一份 Anthropic provider）
# 必需：ANTHROPIC_PROVIDER（anthropic | deepseek | custom）、ANTHROPIC_API_KEY
# 推荐：ANTHROPIC_SMALL_FAST_MODEL（用于会话标题等短任务；留空时由 provider profile 提供默认值）
# 注意：DeviceAgent 依赖 MCP 工具能力；DeepSeek profile 当前 supports_mcp_server_tools=False，
#       使用 DeviceAgent 时请切换到 anthropic 或其他支持 MCP 的 provider。
ANTHROPIC_PROVIDER=deepseek
ANTHROPIC_API_KEY=
# 可选：provider=custom 时必须配置；其他 provider 仅在需要覆盖默认 profile 时配置。
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=
ANTHROPIC_SMALL_FAST_MODEL=
ANTHROPIC_MAX_TOKENS=8192
ANTHROPIC_MAX_TURNS=30
ANTHROPIC_PERMISSION_MODE=acceptEdits
ANTHROPIC_REQUEST_TIMEOUT_SECONDS=1800
ANTHROPIC_MAX_HISTORY_TURNS=10
ANTHROPIC_SMALL_FAST_MAX_TOKENS=1024
ANTHROPIC_SMALL_FAST_REQUEST_TIMEOUT_SECONDS=30
AI_ANALYSIS_MAX_EXTRACT_BYTES=2147483648

# DeviceAgent 专属（Claude Agent SDK 设备联动对话）
DEVICE_AGENT_PERMISSION_TIMEOUT_SECONDS=120
DEVICE_AGENT_RESULT_EXCERPT_BYTES=16384
DEVICE_AGENT_RESULT_MAX_BYTES=262144
DEVICE_AGENT_MAX_REMOTE_TOOLS=64

# ============================================
# 重构包智能检索 Agent 配置 (PackageSearchAgent)
# ============================================
# Claude Agent SDK 驱动的重构包检索。复用 ANTHROPIC_* 配置作为 LLM 入口。
#
# PACKAGE_SEARCH_MAX_TURNS: agent loop 最大轮次（每轮可包含多次工具调用）
# PACKAGE_SEARCH_DEFAULT_LIMIT: 工具默认返回条数
# PACKAGE_SEARCH_MAX_LIMIT: 工具单次返回硬上限，防止上下文爆炸
PACKAGE_SEARCH_MAX_TURNS=8
PACKAGE_SEARCH_DEFAULT_LIMIT=5
PACKAGE_SEARCH_MAX_LIMIT=50
