# 环境配置
ENVIRONMENT=development
HTTP_PORT=8085
IMAGE_TAG=local
DOCKERHUB_NAMESPACE=galaxyspaceai

# 服务配置
HOST=0.0.0.0
PORT=8085
# 标准 Docker 编排由 raven-frontend/nginx 服务前端；单进程部署时可开启后端静态托管。
SERVE_FRONTEND=false
FRONTEND_DIST_DIR=

# 对话分享公开页（系统首个未鉴权读取面）
# PUBLIC_BASE_URL: 公开分享链接 share_url 的站点根地址，如 https://ravenai.example.com。
#   留空时后端回退请求 Origin / Host 拼接（适合本地与多域名部署）。生产建议显式配置。
# SHARE_PUBLIC_RATE_LIMIT / SHARE_PUBLIC_RATE_WINDOW_SECONDS:
#   公开 GET /share/{token} 端点按 IP 的基础限流，抑制对 token 空间的扫描枚举。
PUBLIC_BASE_URL=
SHARE_PUBLIC_RATE_LIMIT=60
SHARE_PUBLIC_RATE_WINDOW_SECONDS=60

# 日志配置
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/app.log
LOG_FILE_MAX_BYTES=52428800
LOG_FILE_BACKUP_COUNT=5
ENABLE_DEBUG_FILE_LOG=false

# 文件配置
MAX_FILE_SIZE=1073741824
TEMP_DIR=temp
LOGS_DIR=logs
DISK_RESERVE_BYTES=536870912

# 安全配置
SECRET_KEY=your-secret-key-here
# 生产必填：与 SECRET_KEY 不同的至少 32 字节随机密钥
PACKAGE_CONFIRMATION_SECRET=

# 数据库配置
DATABASE_URL=
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# Celery配置
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=["json"]
CELERY_TIMEZONE=UTC
CELERY_ENABLE_UTC=true
# 主 worker（log_processing/ai_analysis/maintenance/default 队列）并发数
CELERY_WORKER_CONCURRENCY=2
# Bug 修复专用 worker（bug_fix 队列）并发数
CELERY_BUGFIX_WORKER_CONCURRENCY=1

# Redis配置
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# 协议栈日志处理配置
LOG_PROCESSING_SPEED_MB_PER_SEC=100
MAX_RETRY_ATTEMPTS=3
TASK_TIMEOUT=3600
THREAD_NUM_FOR_DECOMPRESS=15

# SQLite配置（开发环境）
SQLITE_FILE=data/logs.db

# PostgreSQL配置（生产环境）
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=log_staging
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# Raven 包管理（已统一到 FastAPI 后端）
RAVEN_BASE_PATH=/raven
BASE_PATH=/raven
RAVEN_ENABLE_LEGACY_PATHS=true
RAVEN_DATA_DIR=/app/data/raven
RAVEN_METADATA_FILE=/app/data/raven/package-metadata.json
UPLOAD_DIR=/app/data/raven/uploads
UPLOAD_MAX_SIZE_MB=500
LOG_API_PORT=8085
LOG_SERVER_PORT=8085
BUG_FIX_AUTO_DISPATCH=true
# Bug Fix Agent 回合上限：写入型任务回合多（定位/编辑/提交/推送/建 MR × 多个修复项），过小会触发 max_turns_exceeded
BUG_FIX_AGENT_MAX_TURNS=150

# Anthropic 标准 LLM 配置（日志分析 / DeviceAgent / 标题生成 共用同一份 Anthropic provider）
# 必需：ANTHROPIC_PROVIDER，以及 ANTHROPIC_API_KEYS / ANTHROPIC_API_KEY 至少一个
# 可选值取自 app/agents/anthropic_client.py 的 PROVIDER_PROFILES：
#   anthropic | deepseek | aliyun | zhipu | moonshot | minimax | stepfun
#   | mimo | hunyuan | yinhe | custom
# 推荐：ANTHROPIC_SMALL_FAST_MODEL（用于会话标题等短任务；留空时由 provider profile 提供默认值）
# 注意：所选 profile 决定能力矩阵。若上游其实对应某个已知 profile，就填那个名字而不是
#       custom —— custom 的 supports_partial_streaming=False，会静默关掉增量流式
#       （前端拿不到 answer_delta，只能等整段回复）。
ANTHROPIC_PROVIDER=deepseek
# 主力多 Key 池（优先于单 Key），JSON 数组格式；后台「模型设置」也可运行期配置。
ANTHROPIC_API_KEYS=[]
# 兼容单 Key：未配置多 Key 池时继续使用。
ANTHROPIC_API_KEY=
# 可选：provider=custom 时必须配置；其他 provider 仅在需要覆盖默认 profile 时配置。
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=
ANTHROPIC_SMALL_FAST_MODEL=
ANTHROPIC_MAX_TOKENS=8192
ANTHROPIC_MAX_TURNS=30
GENERAL_AGENT_MAX_TURNS=6
ANTHROPIC_PERMISSION_MODE=acceptEdits
ANTHROPIC_REQUEST_TIMEOUT_SECONDS=1800
ANTHROPIC_MAX_HISTORY_TURNS=10
ANTHROPIC_SMALL_FAST_MAX_TOKENS=1024
ANTHROPIC_SMALL_FAST_REQUEST_TIMEOUT_SECONDS=30
AI_ANALYSIS_MAX_EXTRACT_BYTES=2147483648

# --- 模型端点路由（主力降级时自动切换到备用端点）---------------------------
# 典型场景：主力是免费但高峰期很慢的内网网关，备用是付费但随时可用的公网端点。
# 默认走主力，只有主力降级时才切到备用，恢复后自动切回。
#
# 备用端点本身（provider / key / base_url / model）在后台「模型设置」页配置，
# 不放这里：它含密钥，且需要能不重启就改。
#
# 下面的路由策略阈值同样可在「模型设置 → 路由策略」运行时调整，保存后各进程立即
# 生效；这里的值只是**启动兜底**，一旦在后台改过，后台值优先（与主备端点同一套
# 覆盖机制，见 config.OVERRIDABLE_MODEL_KEYS）。改这里需要重启才生效。
#
# 未配置备用端点时，开关为 true 也不会有任何转移：只把真实 TTFT 记进滑动窗口，
# 供后续按实测分布校准 SLOW_TTFT_MS。
MODEL_ROUTER_ENABLED=true
# 首 token 超过此值即记一次「慢」。请按日志里的
# `routed_query: committed slot=primary ttft_ms=...` 实测分布调整。
MODEL_ROUTER_SLOW_TTFT_MS=6000
# 首 token 硬性抢占死线（毫秒）：等待超过此值立刻放弃当前端点、改用下一个候选，
# 用户可感知的等待因此有了上限。SLOW_TTFT_MS 只是事后打标记，救不了当前这条请求。
# 仅在「尚未产生任何模型输出」且「还有下一个候选」时抢占；最后一个候选永不抢占。
# 设为 0 关闭抢占（退回纯事后统计行为）。应 >= SLOW_TTFT_MS。
MODEL_ROUTER_FIRST_TOKEN_DEADLINE_MS=20000
# 最近 N 次调用里有 K 次「慢或失败」即跳闸；样本不足 MIN_SAMPLES 永不跳闸。
MODEL_ROUTER_WINDOW_SIZE=8
MODEL_ROUTER_TRIP_THRESHOLD=4
MODEL_ROUTER_MIN_SAMPLES=4
# 连接拒绝 / 鉴权失败这类硬失败走快速通道，达到此次数即跳闸。
MODEL_ROUTER_HARD_FAILURE_TRIP=2
# 熔断冷却 = 半开探测令牌 TTL：每个冷却期只放行一个真实请求回主力试探，
# 不额外发探测流量给已经过载的网关。
MODEL_ROUTER_COOLDOWN_SECONDS=120
# 滑动窗口 TTL，避免夜间闲置后留下陈旧样本。
MODEL_ROUTER_SAMPLE_TTL_SECONDS=900

# ============================================
# OCR / 视觉理解模型（独立于主力 Anthropic 模型）
# ============================================
# 用户在对话框粘贴/拖拽/选择图片后，图片先由此模型转成文字，再以
# <user_image_ocr> 段合并进用户提示，随后交给任意 Agent。走 OpenAI 兼容端点
# （/compatible-mode/v1/chat/completions，image_url data URL），默认对接阿里云
# 百炼 DashScope Qwen-VL，与 ANTHROPIC_* 主力模型完全解耦。
#
# 未配置 OCR_API_KEY 时对图片自动降级（本轮仅按文本作答，前端提示「图片未被识别」）。
# OCR_MODEL 默认使用阿里云专用 OCR 模型 qwen3.5-ocr；也可使用
# qwen-vl-ocr-latest / qwen-vl-ocr。API Key 必须具备所选模型的访问权限。
# 合规提示：图片会发往上游 OCR provider（默认阿里云北京地域），区域/合规由部署方按
# provider 负责。原始图片字节会落盘（见 CHAT_IMAGE_STORE_DIR）以支持历史回显，
# 数据库中只存元数据；图片随会话删除而清理。
OCR_ENABLED=true
OCR_PROVIDER=dashscope
OCR_BASE_URL=https://llm-0lb9brj2vkuaqqdg.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
OCR_API_KEY=your-ocr-api-key
OCR_MODEL=qwen3.7-plus
OCR_MAX_TOKENS=2048
OCR_REQUEST_TIMEOUT_SECONDS=30
OCR_MAX_IMAGES=6
OCR_MAX_IMAGE_MB=5

# 用户附带图片的原图存储目录（相对路径按项目根目录解析）。图片按
# <session_id>/<image_id>.<ext> 落盘，供前端历史回显时经鉴权端点读取；
# 会话删除时整个目录一并清理。
CHAT_IMAGE_STORE_DIR=temp/chat_images
# 是否把原图物化到 Agent 工作区 <workspace>/images/（为后续多模态铺路）。
# 仅当主力模型 provider 支持图像输入时生效——DeepSeek / custom 等非视觉上游
# 若被 Agent Read 到图片文件会导致整个 run 报错，因此对它们自动跳过。
CHAT_IMAGE_WORKSPACE_MATERIALIZE=true

# Metrics 成本估算价格（单位：美元 / 100 万 token）。留空则不估价，cost 字段返回 null。
# 格式：{"<provider>":{"<model>":{"input_per_million":..,"output_per_million":..,
#        "cache_read_per_million":..,"cache_write_per_million":..}}}
# key 必须与上报的 provider/model 一致（provider=ANTHROPIC_PROVIDER）。
# 下例为 DeepSeek 价格（来源 https://api-docs.deepseek.com/quick_start/pricing/）：
AI_METRICS_PRICING_JSON={"deepseek":{"deepseek-v4-pro":{"input_per_million":0.435,"output_per_million":0.87,"cache_read_per_million":0.003625,"cache_write_per_million":0.435},"deepseek-v4-flash":{"input_per_million":0.14,"output_per_million":0.28,"cache_read_per_million":0.0028,"cache_write_per_million":0.14}}}
# 前端展示层把后端返回的 estimated_cost_usd 换算成人民币；可按实际汇率覆盖。
VITE_USD_TO_CNY_RATE=7.2

# DeviceAgent 专属（Claude Agent SDK 设备联动对话）
DEVICE_AGENT_PERMISSION_TIMEOUT_SECONDS=120
DEVICE_AGENT_RESULT_EXCERPT_BYTES=16384
DEVICE_AGENT_RESULT_MAX_BYTES=262144
DEVICE_AGENT_MAX_REMOTE_TOOLS=64

# ============================================
# 重构包智能检索 Agent 配置 (PackageSearchAgent)
# ============================================
# Claude Agent SDK 驱动的重构包检索。复用 ANTHROPIC_* 配置作为 LLM 入口。
#
# PACKAGE_SEARCH_MAX_TURNS: agent loop 最大轮次（每轮可包含多次工具调用）
# PACKAGE_SEARCH_DEFAULT_LIMIT: 工具默认返回条数
# PACKAGE_SEARCH_MAX_LIMIT: 工具单次返回硬上限，防止上下文爆炸
PACKAGE_SEARCH_MAX_TURNS=8
PACKAGE_SEARCH_DEFAULT_LIMIT=5
PACKAGE_SEARCH_MAX_LIMIT=50
