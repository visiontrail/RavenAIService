# ============================================
# Galaxy Space Package Server 环境变量配置示例
# ============================================
# 使用方法：
# 1. 复制此文件为 .env: cp .env.example .env
# 2. 根据实际环境修改配置值
# 3. 注意：.env 文件不应提交到版本控制系统
# ============================================

# ============================================
# 服务基础配置
# ============================================

# 服务端口
PORT=8083

# Node.js 环境
NODE_ENV=production
# 可选值: development | production

# ============================================
# 路径配置
# ============================================

# 基础路径配置
RAVEN_BASE_PATH=/raven
BASE_PATH=/raven
# 如果两个都设置，RAVEN_BASE_PATH 优先

# 是否启用旧版路径
RAVEN_ENABLE_LEGACY_PATHS=true

# 数据目录配置
RAVEN_DATA_DIR=../data/raven
UPLOAD_DIR=
# 如果未设置，将使用 RAVEN_DATA_DIR/uploads
RAVEN_METADATA_FILE=
# 如果未设置，将使用 RAVEN_DATA_DIR/package-metadata.json
RAVEN_VECTOR_STORE_PATH=
# 如果未设置，将使用 RAVEN_DATA_DIR/vector-store

# ============================================
# 日志服务配置
# ============================================

LOG_API_BASE_URL=
RAVEN_LOG_API_BASE_URL=
LOG_API_PORT=8085
LOG_SERVER_PORT=8085

# ============================================
# RAG 向量搜索配置 (新增)
# ============================================

# Embedding Provider 选择
# 可选值: local | tongyi | openai_compatible
# - local: 使用本地 @xenova/transformers 模型（默认，无需网络）
# - tongyi: 使用阿里云通义千问 Embeddings API（推荐，检索效果更好）
# - openai_compatible: 使用 OpenAI 兼容的 Embeddings API
RAG_EMBEDDING_PROVIDER=tongyi

# Embedding 模型名称
# 根据 provider 不同，支持的模型也不同：
# - tongyi: text-embedding-v1 | text-embedding-v2 | text-embedding-v3 | text-embedding-v4 | multimodal-embedding-v1
#   推荐: text-embedding-v3（最新版本，效果最好）
# - openai_compatible: text-embedding-3-small | text-embedding-3-large | text-embedding-ada-002 等
#   推荐: text-embedding-3-small（性价比高）或 text-embedding-3-large（效果最好）
# - local: 不使用此配置（固定使用 Xenova/paraphrase-multilingual-MiniLM-L12-v2）
RAG_EMBEDDING_MODEL=text-embedding-v4

# ============================================
# 阿里云通义千问 Embeddings 配置
# ============================================
# 当 RAG_EMBEDDING_PROVIDER=tongyi 时需要配置

# 阿里云 API Key（必需）
# 获取方式：
# 1. 访问 https://dashscope.console.aliyun.com/
# 2. 登录后进入"API-KEY管理"
# 3. 创建新的 API Key
# 4. 复制 API Key 并填入此处
ALIBABA_API_KEY=your_alibaba_api_key_here

# ============================================
# OpenAI 兼容 Embeddings 配置
# ============================================
# 当 RAG_EMBEDDING_PROVIDER=openai_compatible 时需要配置

# OpenAI API Key（必需）
# 如果使用第三方兼容网关（如 oneapi），使用网关提供的 API Key
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI API Base URL（可选）
# 如果使用第三方兼容网关（如 oneapi），需要设置此值
# 例如: http://oneapi.yhroot.com/v1
# 如果不设置，将使用 OpenAI 官方 API: https://api.openai.com/v1
OPENAI_BASE_URL=http://oneapi.yhroot.com/v1

# ============================================
# 使用示例
# ============================================
#
# 示例 1: 使用本地嵌入模型（默认，无需额外配置）
#    RAG_EMBEDDING_PROVIDER=local
#
# 示例 2: 使用通义千问 Embeddings（推荐用于生产环境）
#    RAG_EMBEDDING_PROVIDER=tongyi
#    ALIBABA_API_KEY=sk-xxxxxxxxxxxxx
#    RAG_EMBEDDING_MODEL=text-embedding-v3
#
# 示例 3: 使用 OpenAI 兼容 Embeddings（通过 oneapi 网关）
#    RAG_EMBEDDING_PROVIDER=openai_compatible
#    OPENAI_API_KEY=sk-xxxxxxxxxxxxx
#    OPENAI_BASE_URL=http://oneapi.yhroot.com/v1
#    RAG_EMBEDDING_MODEL=Qwen3-Embedding-8B
#
# ============================================
# 注意事项
# ============================================
#
# 1. 切换 Embedding Provider 或 Model 时，系统会自动检测并重建向量库
#    旧向量库会被删除，需要重新索引所有包数据
#    建议在低峰期进行切换操作
#
# 2. 向量库元信息保存在: {RAVEN_VECTOR_STORE_PATH}.meta.json
#    包含 provider 和 modelName 信息，用于检测配置变更
#    不要手动删除此文件，除非确定要重建向量库
#
# 3. 如果向量维度不匹配导致检索错误，系统会自动触发重建
#    重建过程可能需要较长时间，取决于包的数量
#
# 4. 生产环境建议：
#    - 使用云端 Embedding（tongyi 或 openai_compatible）以获得更好的检索效果
#    - 设置合适的 RAG_EMBEDDING_MODEL
#       * 通义千问推荐: text-embedding-v3
#       * OpenAI 兼容推荐: text-embedding-3-small（性价比）或 text-embedding-3-large（效果）
#    - 确保 API Key 安全，不要提交到版本控制系统
#    - 定期备份向量库目录（{RAVEN_VECTOR_STORE_PATH}）
#
# 5. 性能提示：
#    - 本地模型（local）: 无需网络，但检索效果一般，适合开发测试
#    - 通义千问（tongyi）: 检索效果最好，支持中文优化，推荐生产使用
#    - OpenAI 兼容: 兼容性好，但可能对中文支持不如通义千问
#
# ============================================
