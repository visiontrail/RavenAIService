# The service binds to loopback by default. Set 0.0.0.0 only when it is placed
# behind an authenticated reverse proxy or otherwise protected.
MODEL_SENTINEL_BIND_IP=127.0.0.1
MODEL_SENTINEL_PORT=8765
MODEL_SENTINEL_TIMEZONE=Asia/Singapore

# Non-secret bootstrap values copied from Raven's primary model settings.
# They are only used when the persistent database is initialized.
TARGET_NAME=银河私有模型集群
TARGET_PROTOCOL=anthropic
TARGET_BASE_URL=http://oneapi.yhroot.com
TARGET_MODEL=yinhe-thinking
TARGET_INTERVAL_SECONDS=300
TARGET_TIMEOUT_SECONDS=1800
TARGET_MAX_TOKENS=1024
